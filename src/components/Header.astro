---
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const links = [
  {
    href: '/',
    label: 'Post',
    active:
      path === '/' ||
      path.startsWith('/post/') ||
      path.startsWith('/argomenti/'),
  },
  {
    href: '/progetti',
    label: 'Progetti',
    active: path.startsWith('/progetti'),
  },
  {
    href: '/contatti',
    label: 'Contatti',
    active: path.startsWith('/contatti'),
  },
];
---

<header>
  <div class="col">
    <a class="brand" href="/">
      orange-dinosaur
    </a>
    <nav aria-label="Principale">
      {links.map(({ href, label, active }) => (
        <a href={href} aria-current={active ? 'page' : undefined}>
          {label}
        </a>
      ))}
      <ThemeToggle />
    </nav>
  </div>
</header>

<script>
  const head = document.querySelector('header')!;
  const stuck = () => head.classList.toggle('stuck', window.scrollY > 4);
  stuck();
  window.addEventListener('scroll', stuck, { passive: true });
</script>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--bg);
    border-bottom: var(--border-w) solid transparent;
    transition: border-color 0.2s;
  }
  header.stuck {
    border-bottom-color: var(--line);
  }
  @media (prefers-reduced-motion: reduce) {
    header {
      transition: none;
    }
  }
  .col {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s5);
    padding-top: var(--s5);
    padding-bottom: var(--s5);
  }
  .brand {
    white-space: nowrap;
    font-family: var(--f-display);
    font-size: 30px;
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .brand:hover {
    color: var(--accent-text);
  }
  nav {
    display: flex;
    align-items: center;
    gap: var(--s5);
  }
  nav a {
    white-space: nowrap;
    font-family: var(--f-mono);
    font-size: 14px;
    border-bottom: 1px solid transparent;
  }
  nav a:hover {
    border-bottom-color: var(--accent);
  }
  nav a[aria-current='page'] {
    border-bottom-color: var(--ink);
  }

  @media (max-width: 600px) {
    .col {
      padding-top: var(--s4);
      padding-bottom: var(--s4);
      gap: var(--s3);
    }
    nav {
      gap: 14px;
    }
    nav a {
      font-size: 13px;
    }
    .brand {
      font-size: 23px;
    }
  }
  @media (max-width: 420px) {
    .col {
      gap: var(--s2);
    }
    .brand {
      font-size: 18px;
    }
    nav {
      gap: 8px;
    }
    nav a {
      font-size: 12px;
    }
  }
  @media (max-width: 340px) {
    .brand {
      font-size: 15px;
    }
    nav {
      gap: 5px;
    }
    nav a {
      font-size: 11px;
    }
  }
</style>
