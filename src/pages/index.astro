---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import TopicSelect from '../components/TopicSelect.astro';
import { getPosts } from '../lib/content';

const posts = await getPosts();
---

<BaseLayout>
  <main class="col">
    <TopicSelect />
    {posts.length ? (
      <PostList posts={posts} />
    ) : (
      <p class="empty">Ancora nessun post.</p>
    )}
  </main>
</BaseLayout>

<style>
  .empty {
    padding: var(--s5) 0;
    color: var(--muted);
  }
</style>
